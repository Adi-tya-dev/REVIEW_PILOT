# ==============================================================================
# REVIEWPILOT – ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and replace placeholders with your actual settings.
# Never commit the .env file to version control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change_me_to_a_secure_random_string_in_production
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Settings (SQLite default, PostgreSQL-ready)
# For SQLite: sqlite+aiosqlite:///./reviewpilot.db
# For PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/reviewpilot
DATABASE_URL=sqlite+aiosqlite:///./reviewpilot.db

# GitHub Integration
# Required for fetching PR diffs, repo metadata, and posting review comments.
GITHUB_TOKEN=ghp_your_github_personal_access_token_here
# Secret for HMAC-SHA256 GitHub webhook payload verification
GITHUB_WEBHOOK_SECRET=your_webhook_hmac_secret_here

# Local SLM (Ollama) Settings
OLLAMA_BASE_URL=http://localhost:11434
SLM_MODEL_NAME=qwen2.5-coder:1.5b
SLM_TIMEOUT_SECONDS=60

# Cloud LLM Escalation Settings (Optional - set to 'ollama' or cloud provider)
LLM_PROVIDER=ollama
# If using a cloud provider (e.g. openai, openrouter, anthropic, gemini):
LLM_API_KEY=
LLM_MODEL_NAME=qwen2.5-coder:7b
LLM_BASE_URL=http://localhost:11434/v1

# Router Parameters & Thresholds
ROUTER_COMPLEXITY_THRESHOLD=10
ROUTER_CONFIDENCE_THRESHOLD=0.75
ROUTER_MAX_ESCALATION_ATTEMPTS=2

# Docker Sandbox Settings
DOCKER_IMAGE=python:3.11-slim
DOCKER_EXECUTION_TIMEOUT_SECONDS=15
DOCKER_MEMORY_LIMIT=512m
DOCKER_CPU_LIMIT=1.0
DOCKER_NETWORK_MODE=none

